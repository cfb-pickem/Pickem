{
  "name": "cfb-pickem",
  "version": "1.0.0",
  "private": true,
  "description": "CFB Pick'em \u2014 static site served from GitHub Pages",
  "scripts": {
    "css": "tailwindcss -i ./css/tailwind.src.css -o ./css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./css/tailwind.src.css -o ./css/tailwind.css --watch",
    "vendor": "esbuild build/supabase-entry.js --bundle --format=esm --minify --target=es2022 --platform=browser --legal-comments=none --outfile=js/vendor/supabase.js",
    "build": "npm run css && npm run vendor && npm run stamp",
    "stamp": "node tools/stamp-assets.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "esbuild": "^0.28.2",
    "supabase": "^2.115.0",
    "tailwindcss": "3.4.17"
  }
}
