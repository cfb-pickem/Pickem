<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Live CFB news for Picky (news.py): Ross Dellenger's Yahoo articles + ESPN
  + CBS college football news, cached to server/cache/news.json (headline,
  date, link, short summary; 7 days). Fires every 15 min; news.py itself
  skips unless 30 min have passed (15 on Saturdays 11am-midnight CT).
  Free public feeds only; Ollama (local) only to condense the rare long blurb,
  and only while chat has no member traffic. chat.py reads the cache only.
  Install: cp to ~/Library/LaunchAgents and launchctl load it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickem.news-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Agent/cfb-pickem/server/.venv/bin/python3</string>
        <string>/Users/Agent/cfb-pickem/server/news.py</string>
        <string>refresh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Agent/cfb-pickem/server</string>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/news.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/news.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>PICKEM_CHAT_MODEL</key>
        <string>qwen3.5:9b-q4_K_M</string>
    </dict>
</dict>
</plist>
