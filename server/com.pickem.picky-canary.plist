<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Picky canary (review R5): every 15 min, one X-Picky-Test ask through the live /group
  (code lane, code_only: no model call, nothing saved). Rows: cfb-pickem-private/picky_canary.jsonl.
  Two failures in a row: ALERT line in ~/Library/Logs/picky-watchdog.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickem.picky-canary</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-I</string>
        <string>/Users/Agent/picky-live/server/canary.py</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/canary.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/canary.log</string>
</dict>
</plist>
