<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CFBD post-final refresh (review R6): Saturday ~16:30 and ~20:30 CT and Sunday 00:30 CT pull
  only records + lines (scores) + ats, 3 calls a run (~36/month), so team W-Ls and finals are
  current after each wave of games. fact_guard.finals_overrides covers the gap between runs from
  live_games.json. cfbd.py's own 300/month cap and the shared-key reserve still apply.
  Data only (no code), so it runs during the game-day freeze.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickem.cfbd-finals</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Agent/cfb-pickem/server/.venv/bin/python3</string>
        <string>-I</string>
        <string>/Users/Agent/cfb-pickem/server/cfbd.py</string>
        <string>refresh</string>
        <string>records</string>
        <string>lines</string>
        <string>ats</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Agent/cfb-pickem/server</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>16</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>0</integer>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/cfbd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/cfbd.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
