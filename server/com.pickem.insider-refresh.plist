<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Picky's insider notes (insider_refresh.py tick), every 2 hours. Each tick
  rebuilds the code-only headline wire (cfb-pickem-private/insider_wire.json:
  insider-bylined headlines from the news cache, byline, date, team tags). The
  Opus notes refresh (one offline claude -p via picky_claude.py on Charlie's
  subscription, ANTHROPIC_API_KEY stripped, web tools + Read/Edit only, zero MCP
  servers) runs only when the notes are 3+ days old, at most one attempt a day,
  never with PICKY_NO_ANTHROPIC=1; it swaps cfb-pickem-private/insider_bank.md
  only after its validator passes. No Ollama, no RAM lock needed.
  Logs: server/logs/insider_refresh.log.
  Install: cp to ~/Library/LaunchAgents and launchctl bootstrap gui/$(id -u) it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickem.insider-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Agent/cfb-pickem/server/.venv/bin/python3</string>
        <string>-I</string>
        <string>/Users/Agent/cfb-pickem/server/insider_refresh.py</string>
        <string>tick</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Agent/cfb-pickem/server</string>
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/insider_refresh.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/insider_refresh.launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/Agent</string>
        <key>TERM</key>
        <string>dumb</string>
        <key>DISABLE_AUTOUPDATER</key>
        <string>1</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
