<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Once-a-day OFFLINE Opus spot check of news.py's plain-code tagging
  (news_qa.py). Reads the cache only; if too many sampled stories are tagged
  wrong it opens a feed-monitor repair branch (news.py only, merged only if
  test_news.py passes). Never part of the 5-minute news refresh.
  Install: cp to ~/Library/LaunchAgents, then launchctl bootstrap gui/$UID it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickem.news-qa</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Agent/cfb-pickem/server/.venv/bin/python3</string>
        <string>-I</string>
        <string>/Users/Agent/cfb-pickem/server/news_qa.py</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Agent/cfb-pickem/server</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/news-qa.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/news-qa.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
