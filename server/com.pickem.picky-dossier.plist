<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Picky's game dossiers (dossier.py). Fires every 30 minutes; dossier.py
  decides if anything is due (new pool game / Fri 5 PM / Sat 7 AM CT) and
  exits after two Supabase GETs when not. Every run is pure code over the
  news cache + r/CFB (no model). Opus web research + the analyst take run at
  most once a week per game (Fri 5 PM - Sun window, or dossier.py run --opus)
  via picky_claude (ANTHROPIC_API_KEY stripped, web tools only, zero MCP
  servers). Logs: server/logs/dossier.log.
  Install: cp to ~/Library/LaunchAgents and launchctl load it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickem.picky-dossier</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Agent/cfb-pickem/server/.venv/bin/python3</string>
        <string>-I</string>
        <string>/Users/Agent/cfb-pickem/server/dossier.py</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Agent/cfb-pickem/server</string>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/dossier.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Agent/cfb-pickem/server/logs/dossier.launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/Agent</string>
        <key>TERM</key>
        <string>dumb</string>
        <key>DISABLE_AUTOUPDATER</key>
        <string>1</string>
        <key>PICKEM_CHAT_MODEL</key>
        <string>gemma4:12b-it-qat</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
